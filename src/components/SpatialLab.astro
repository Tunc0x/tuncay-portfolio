<div class="spatial-lab" data-spatial-lab>
  <div class="lab-heading">
    <span class="mono">SPATIAL COORDINATE LAB</span>
    <span class="lab-type">Interactive 3D</span>
  </div>
  <div class="spatial-viewport">
    <div class="spatial-fallback">
      <svg
        viewBox="0 0 540 310"
        role="img"
        aria-label="A marker plane anchors a local 3D coordinate frame. X points right, Y points upwards and Z points towards the viewer."
      >
        <g fill="none" stroke="#6c7981">
          <path d="M100 223l186-87 166 87-184 88Z" />
          <path d="M142 203l166 87M187 181l166 88M233 159l166 87M142 245l187-87M183 268l187-89M225 289l187-89" />
        </g>
        <g stroke-width="2" fill="none">
          <path stroke="#b9d894" d="M268 224V73" />
          <path stroke="#afa1d1" d="M268 224l105 50" />
          <path stroke="#82bbd1" d="M268 224l-104 49" />
        </g>
        <g fill="#d8ddd4" class="svg-label">
          <text x="261" y="60">
            Y
          </text>
          <text x="380" y="280">
            X
          </text>
          <text x="145" y="281">
            Z
          </text>
          <text x="310" y="166">
            LOCAL SPACE
          </text>
        </g>
        <path
          d="M222 118l46-24 46 24v56l-46 24-46-24Z M222 118l46 24 46-24M268 142v56"
          fill="#bddb9840"
          stroke="#c2dea3"
        />
      </svg>
    </div>
    <div class="spatial-canvas" aria-hidden="true"></div>
    <div class="spatial-label mono">MARKER → LOCAL SPACE → MODEL</div>
  </div>
  <div class="spatial-controls">
    <button type="button" class="small-button spatial-load">
      Explore in 3D <span aria-hidden="true">↗</span>
    </button>
    <button type="button" class="text-button spatial-reset" hidden>
      Reset view
    </button>
    <label class="spatial-rotation" hidden>
      Rotation{' '}
      <input
        aria-label="Model rotation"
        type="range"
        min="-180"
        max="180"
        value="25"
      />
    </label>
  </div>
  <p class="lab-footnote spatial-status" aria-live="polite">
    An illustration of marker-relative positioning. No camera required.
  </p>
</div>
